{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "fraccional-googleworkspace-mcp",
  "version": "0.1.0",
  "identifier": "com.fraccional.googleworkspace.mcp",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "fraccional-googleworkspace-mcp",
        "width": 640,
        "height": 720,
        "visible": false
      },
      {
        "label": "skills",
        "title": "Skills de fraccional-googleworkspace-mcp",
        "url": "index.html?window=skills",
        "width": 560,
        "height": 520,
        "visible": false
      },
      {
        "label": "install",
        "title": "Conectar un agente",
        "url": "index.html?window=install",
        "width": 600,
        "height": 680,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: https://*.googleusercontent.com; connect-src ipc: http://ipc.localhost; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDAwMDIzQTA4N0Y0RjQwMzMKUldRelFFOS9DRG9DQUJ3Sk00L1A3UFdMSkNiK04zRnhyK3NVdUxTbTFlUTd4WW8veHhScVlFWnYK",
      "endpoints": ["https://github.com/urvana/fraccional-googleworkspace-mcp/releases/latest/download/latest.json"]
    }
  }
}
